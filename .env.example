# --- OpenRouter ---
# Consegui tu key en https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-...

# Modelo. Para MAXIMO ahorro usa un modelo con prompt caching (Claude / Gemini via OpenRouter).
# Ej.: anthropic/claude-sonnet-4  |  anthropic/claude-3.7-sonnet  |  google/gemini-2.5-pro
# Los modelos gratuitos (sufijo ":free") tambien funcionan (ver README) pero OpenRouter
# los rota SIN AVISO cuando el proveedor retira la promocion — usa GLAIVE_MODEL_FALLBACK.
GLAIVE_MODEL=anthropic/claude-sonnet-4

# Si GLAIVE_MODEL deja de estar disponible (404 "unavailable"), glaive reintenta UNA vez
# con este modelo automaticamente, sin cortar la sesion. Vacio = sin fallback.
GLAIVE_MODEL_FALLBACK=

# Modelo barato para tareas mecanicas / compactacion (opcional; por defecto usa GLAIVE_MODEL)
GLAIVE_MODEL_CHEAP=anthropic/claude-3.5-haiku

# --- Sandbox de ejecucion ---
# auto (docker si esta disponible, si no local) | docker | local
GLAIVE_SANDBOX=auto
# Imagen docker con herramientas de pentest (nmap, curl, sqlmap...). Se usa solo en modo
# docker. glaive-sandbox:latest es la imagen curada propia (glaive/docker/Dockerfile) —
# se construye sola la primera vez que corres glaive run.
GLAIVE_SANDBOX_IMAGE=glaive-sandbox:latest

# --- Presupuesto / limites ---
GLAIVE_MAX_ITERATIONS=60
GLAIVE_TOOL_OUTPUT_CHARS=2000
GLAIVE_CONTEXT_COMPACT_TOKENS=120000
